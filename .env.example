# Copy this file to .env and fill in real values. Never commit .env itself.

# From your AgentMail dashboard / API key management page.
AGENTMAIL_API_KEY=

# The AgentMail inbox to check, e.g. ideas@yourdomain.agentmail.to
AGENTMAIL_INBOX_ID=

# Optional. Defaults shown below -- only set these if you want the
# database or log file somewhere other than the project's data/ folder.
# DATABASE_PATH=data/ideas.db
# LOG_PATH=data/app.log
