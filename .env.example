# This is a TEMPLATE with placeholders only -- safe to commit.
#
# Your real .env goes at C:\Users\<you>\IdeaScoutLocal\.env -- NOT in this
# repo. Create that file yourself (copy this one there as a starting
# point) and fill in real values. IdeaScout only ever reads that file; it
# never writes, moves, or deletes it, and it never reads a repo-root .env.

# From your AgentMail dashboard / API key management page.
AGENTMAIL_API_KEY=

# The AgentMail inbox to check, e.g. ideas@yourdomain.agentmail.to
AGENTMAIL_INBOX_ID=

# From your Anthropic Console account (console.anthropic.com) -- API Keys
# page. Required for `python run.py parse-mail`. Not needed for check-mail
# or status.
ANTHROPIC_API_KEY=

# One or more of Brad's own email addresses, comma-separated. Required for
# `python run.py parse-mail`. Only messages sent FROM one of these
# addresses are ever handed to the feedback parser -- this is what stops
# newsletters/Substacks/etc. that later land in the same inbox from being
# mistaken for Brad's own feedback. Example:
# BRAD_ALLOWED_SENDERS=brad@farviewcapitalmgmt.com,brad.hathaway@gmail.com
BRAD_ALLOWED_SENDERS=

# Optional. Which Claude model parses feedback emails. Defaults to a cheap,
# fast model well suited to this kind of short structured extraction --
# only set this if you want to use a different one.
# PARSER_MODEL_NAME=claude-haiku-4-5

# Optional. Which Claude model builds Far View Idea Taste (`build-taste`).
# Defaults to Anthropic's most capable model, since synthesizing nuanced
# taste from a whole corpus of feedback is a much harder task than
# per-message extraction -- only set this if you want a different one.
# Reuses ANTHROPIC_API_KEY above; no separate credential needed.
# TASTE_MODEL_NAME=claude-opus-5

# Optional. By default the database and log file live in IdeaScoutLocal
# alongside this .env -- only set these if you want them somewhere else.
# DATABASE_PATH=C:\Users\brad\IdeaScoutLocal\ideas.db
# LOG_PATH=C:\Users\brad\IdeaScoutLocal\app.log

# Optional. Path to Far View's own permanent, manually curated
# IDEA_SCREEN_RULES.md (lives in the separate InvestmentBrain repo, never
# in IdeaScout or IdeaScoutLocal). Required for `python run.py
# shadow-score`. Defaults to Brad's real path below -- only set this if it
# ever moves.
# SCREEN_RULES_PATH=C:\Users\brad\Repos\InvestmentBrain\IDEA_SCREEN_RULES.md
